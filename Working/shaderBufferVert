#version 460

layout(location = 0) in vec3 vertPos;
layout(location = 3) in vec2 vertUVCoord;

uniform mat4 modelMat;
uniform float aspectRatio;

out vec2 uvCoord;

void main()
{
	vec4 transformedPos = modelMat * vec4(vertPos, 1.0);
	//transformedPos.x /= aspectRatio;
	
	gl_Position = vec4(transformedPos.x / 2, transformedPos.y / 2, 0.0, 1.0);
	uvCoord = vertUVCoord;
}